# Configurazione pyHPSU con Google Cloud Pub/Sub
# Copia questo file in /etc/pyHPSU/pyhpsu.conf e modifica i parametri

# Settings for pyHPSUd
[PYHPSUD]
PYHPSUD_DEVICE=PYCAN
PYHPSUD_LANG=IT
PYHPSUD_PORT=/dev/ttyUSB0

# Settings for pyHPSU
[PYHPSU]
PYHPSU_DEVICE = PYCAN
PYHPSU_PORT = /dev/ttyS0
PYHPSU_LANG = IT
OUTPUT_TYPE = MQTT

[CANPI]
timeout=0.05

# Configurazione MQTT locale (opzionale)
# Lascia vuoto o commenta se non usi un broker MQTT locale
[MQTT]
BROKER = localhost
PORT = 1883
CLIENTNAME = rotex_hpsu
PREFIX = rotex
QOS = 0

# Configurazione Google Cloud Pub/Sub
[GCP_PUBSUB]
# Abilita/disabilita pubblicazione su GCP (true/false)
ENABLED = true

# ID del progetto Google Cloud
PROJECT_ID = your-gcp-project-id

# ID del topic Pub/Sub (deve essere creato prima su GCP)
TOPIC_ID = hpsu-telemetry

# ID del dispositivo (identificatore univoco per questo dispositivo)
DEVICE_ID = hpsu-001

# Percorso al file JSON del service account
# Scarica il file da: GCP Console > IAM & Admin > Service Accounts
# Il service account deve avere il ruolo "Pub/Sub Publisher"
CREDENTIALS_FILE = /etc/pyHPSU/keys/service-account.json

# Nota: Se non specifichi CREDENTIALS_FILE, il sistema userà
# Application Default Credentials (ADC). Utile se esegui su GCE/GKE.

# Interval for each query for a value in seconds
# Values not listed here are not queried
[JOBS]
T_HS = 30
T_HS_SET = 60
water_pressure = 60
t_ext = 60
t_dhw = 60
t_dhw_set = 120
t_return = 30
flow_rate = 30
t_hc = 30
t_hc_set = 60
